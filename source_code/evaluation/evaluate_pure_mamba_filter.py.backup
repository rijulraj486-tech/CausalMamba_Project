#!/usr/bin/env python3
"""Evaluate a pure Mamba neural filter checkpoint."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import torch

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from datasets.normalization import ChannelStats, fit_channel_stats  # noqa: E402
from models.pure_mamba_filter import PureMambaFilterConfig, build_pure_mamba_filter  # noqa: E402
from training.train_pure_mamba_filter import (  # noqa: E402
    FilterNormalizerBundle,
    PureMambaFilterDataConfig,
    evaluate_filter_sessions,
    load_sessions,
)


def run_evaluation_smoke() -> None:
    target_xy = torch.tensor([[-720.0, -300.0], [-300.0, -100.0], [109.0, 40.0]])
    stats = fit_channel_stats(target_xy, "robust")
    normalizers = FilterNormalizerBundle(
        wheel=ChannelStats("none", torch.zeros(7), torch.ones(7)),
        gps=ChannelStats("none", torch.zeros(10), torch.ones(10)),
        imu=ChannelStats("none", torch.zeros(11), torch.ones(11)),
        target_xy=stats,
    )
    normalized = normalizers.target_xy.normalize(target_xy)
    denormalized = normalizers.denormalize_xy(normalized)
    if not torch.allclose(target_xy, denormalized, atol=1.0e-4):
        raise RuntimeError("Evaluation smoke failed target XY inverse normalization.")
    print(
        json.dumps(
            {
                "event": "evaluation_smoke_ok",
                "denormalized_prediction_min": float(denormalized.min().item()),
                "denormalized_prediction_max": float(denormalized.max().item()),
            }
        ),
        flush=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--checkpoint", default="")
    parser.add_argument("--split", default="test", choices=["train", "val", "test"])
    parser.add_argument("--data-path", default="")
    parser.add_argument("--output", default="")
    parser.add_argument("--smoke", action="store_true")
    args = parser.parse_args()

    if args.smoke:
        run_evaluation_smoke()
        return 0
    if not args.checkpoint:
        raise SystemExit("--checkpoint is required unless --smoke is set")

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    ckpt = torch.load(args.checkpoint, map_location="cpu")
    model_cfg = PureMambaFilterConfig(**ckpt["model_config"])
    data_cfg = PureMambaFilterDataConfig(**ckpt["data_config"])
    normalizers = FilterNormalizerBundle.from_dict(ckpt["normalizers"])
    model = build_pure_mamba_filter(model_cfg).to(device)
    model.load_state_dict(ckpt["model"])

    if args.data_path:
        data_path = Path(args.data_path)
    else:
        data_path = Path(getattr(data_cfg, f"{args.split}_path"))
    sessions = load_sessions(data_path)
    metrics = evaluate_filter_sessions(model, sessions, data_cfg, normalizers, device)
    payload = {
        "checkpoint": args.checkpoint,
        "split": args.split,
        "overall_rmse_m": metrics["overall_rmse_m"],
        "per_trajectory": metrics["per_trajectory"],
    }
    print(json.dumps(payload, indent=2))
    if args.output:
        Path(args.output).write_text(json.dumps(payload, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
